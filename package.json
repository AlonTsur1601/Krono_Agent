{
  "name": "krono-agent",
  "version": "0.1.4",
  "description": "Native Windows agent workspace with project memory and games",
  "author": "Alon Tsur",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run build && powershell.exe -NoProfile -File scripts/run-native.ps1",
    "build": "powershell.exe -NoProfile -File scripts/build-native.ps1",
    "build:engine": "node scripts/build-engine.cjs",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native": "node scripts/native-smoke.cjs",
    "package:win": "powershell.exe -NoProfile -File scripts/build-native.ps1 -Publish"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@google/genai": "2.32.0",
    "node-pty": "^1.0.0",
    "openai": "7.49.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "typescript": "^5.3.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
