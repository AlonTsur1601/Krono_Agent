<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Krono_Agent.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ColorPaletteResources x:Key="Default" Accent="#51BB82">
                    <SolidColorBrush x:Key="KronoBackground" Color="#10151D" />
                    <SolidColorBrush x:Key="KronoSidebar" Color="#141B24" />
                    <SolidColorBrush x:Key="KronoSurface" Color="#1B2532" />
                    <SolidColorBrush x:Key="KronoBorder" Color="#2B3B4C" />
                    <SolidColorBrush x:Key="KronoMuted" Color="#9AABBF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#293D48" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#344D59" />
                    <SolidColorBrush x:Key="KronoAccentForeground" Color="#84E6B1" />
                    <SolidColorBrush x:Key="KronoAccentFill" Color="#84E6B1" />
                    <SolidColorBrush x:Key="KronoAccentHover" Color="#A0F0C5" />
                    <SolidColorBrush x:Key="KronoAccentPressed" Color="#70D39F" />
                    <SolidColorBrush x:Key="KronoLoginBackdrop" Color="#111D20" />
                    <SolidColorBrush x:Key="KronoOutlineHover" Color="#537D70" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#84E6B1" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#70D39F" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#5CC08C" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#84E6B1" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#A0F0C5" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#70D39F" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#84E6B1" />
                </ColorPaletteResources>
                <ColorPaletteResources x:Key="Light" Accent="#278254">
                    <SolidColorBrush x:Key="KronoBackground" Color="#F2F5F7" />
                    <SolidColorBrush x:Key="KronoSidebar" Color="#E7EEF0" />
                    <SolidColorBrush x:Key="KronoSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="KronoBorder" Color="#CDDADC" />
                    <SolidColorBrush x:Key="KronoMuted" Color="#536D78" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D8E9E5" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C3DDD6" />
                    <SolidColorBrush x:Key="KronoAccentForeground" Color="#17613E" />
                    <SolidColorBrush x:Key="KronoAccentFill" Color="#84E6B1" />
                    <SolidColorBrush x:Key="KronoAccentHover" Color="#A0F0C5" />
                    <SolidColorBrush x:Key="KronoAccentPressed" Color="#70D39F" />
                    <SolidColorBrush x:Key="KronoLoginBackdrop" Color="#E9F3EF" />
                    <SolidColorBrush x:Key="KronoOutlineHover" Color="#608678" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#84E6B1" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#70D39F" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#5CC08C" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#17613E" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#145437" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#236D49" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#21774F" />
                </ColorPaletteResources>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#10231F" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#10231F" />
            <FontFamily x:Key="KronoTextFont">ms-appx:///Assets/Fonts/Rubik.ttf#Rubik</FontFamily>
            <FontFamily x:Key="KronoDisplayFont">ms-appx:///Assets/Fonts/SpaceGrotesk.ttf#Space Grotesk</FontFamily>
            <FontFamily x:Key="KronoCodeFont">ms-appx:///Assets/Fonts/JetBrainsMono.ttf#JetBrains Mono</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Rubik.ttf#Rubik</FontFamily>
            <x:Double x:Key="KronoTextSize">14</x:Double>
            <x:Double x:Key="KronoCodeSize">14</x:Double>
            <x:Double x:Key="KronoControlMinHeight">40</x:Double>
            <Style TargetType="Button">
                <Setter Property="MinHeight" Value="{StaticResource KronoControlMinHeight}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
                <Setter Property="FontSize" Value="{ThemeResource KronoTextSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{ThemeResource KronoSurface}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KronoBorder}" />
            </Style>
            <Style x:Key="KronoPrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinHeight" Value="{StaticResource KronoControlMinHeight}" />
                <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
                <Setter Property="FontSize" Value="{ThemeResource KronoTextSize}" />
                <Setter Property="Background" Value="{ThemeResource KronoAccentFill}" />
                <Setter Property="Foreground" Value="#10231F" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="MinHeight" Value="{StaticResource KronoControlMinHeight}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
                <Setter Property="FontSize" Value="{ThemeResource KronoTextSize}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,10,12,6" />
                <Setter Property="Background" Value="{ThemeResource KronoSurface}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KronoBorder}" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="{StaticResource KronoControlMinHeight}" />
                <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
                <Setter Property="FontSize" Value="{ThemeResource KronoTextSize}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Background" Value="{ThemeResource KronoSurface}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KronoBorder}" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="{StaticResource KronoControlMinHeight}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
                <Setter Property="FontSize" Value="{ThemeResource KronoTextSize}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,10,12,6" />
                <Setter Property="Background" Value="{ThemeResource KronoSurface}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KronoBorder}" />
            </Style>
            <Style TargetType="NumberBox">
                <Setter Property="MinHeight" Value="{StaticResource KronoControlMinHeight}" />
                <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
                <Setter Property="FontSize" Value="{ThemeResource KronoTextSize}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource KronoSurface}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KronoBorder}" />
            </Style>
            <Style TargetType="AppBarButton">
                <Setter Property="MinHeight" Value="{StaticResource KronoControlMinHeight}" />
                <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
                <Setter Property="FontSize" Value="{ThemeResource KronoTextSize}" />
                <Setter Property="Padding" Value="0,8,0,8" />
            </Style>
            <Style TargetType="NavigationViewItem">
                <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
                <Setter Property="FontSize" Value="{ThemeResource KronoTextSize}" />
            </Style>
            <Style TargetType="ContentDialog">
                <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background" Value="{ThemeResource KronoSurface}" />
                <Setter Property="BorderBrush" Value="{ThemeResource KronoBorder}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
