<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Krono_Agent.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:Krono_Agent"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Buttons.xaml" />
                <ResourceDictionary Source="Styles/TextInputs.xaml" />
                <ResourceDictionary Source="Styles/Dropdowns.xaml" />
                <ResourceDictionary Source="Styles/Menus.xaml" />
                <ResourceDictionary Source="Styles/PasswordInputs.xaml" />
                <ResourceDictionary Source="Styles/NumericInputs.xaml" />
                <ResourceDictionary Source="Styles/CheckBoxes.xaml" />
                <ResourceDictionary Source="Styles/NavigationItems.xaml" />
                <ResourceDictionary Source="Styles/Dialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ColorPaletteResources x:Key="Default" Accent="#51BB82">
                    <SolidColorBrush x:Key="KronoBackground" Color="#10151D" />
                    <SolidColorBrush x:Key="KronoSidebar" Color="#141B24" />
                    <SolidColorBrush x:Key="KronoContextRail" Color="#1A2430" />
                    <SolidColorBrush x:Key="KronoSurface" Color="#1B2532" />
                    <SolidColorBrush x:Key="KronoInputFace" Color="#19232F"/>
                    <StaticResource x:Key="TabViewItemHeaderBackground" ResourceKey="KronoSidebar" />
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="KronoSurface" />
                    <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver" ResourceKey="KronoInputFace" />
                    <StaticResource x:Key="TabViewItemHeaderBackgroundPressed" ResourceKey="KronoSurface" />
                    <SolidColorBrush x:Key="KronoInputRim" Color="#344452" />
                    <SolidColorBrush x:Key="KronoInputShade" Color="#111A24" />
                    <SolidColorBrush x:Key="KronoDisabledFace" Color="#354353"/>
                    <SolidColorBrush x:Key="KronoDisabledBase" Color="#26323E"/>
                    <SolidColorBrush x:Key="KronoDisabledInk" Color="#D2DCE5"/>
                    <LinearGradientBrush x:Key="KronoButtonFace" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2D3A49" Offset="0"/><GradientStop Color="#1A2430" Offset="1"/></LinearGradientBrush>
                    <LinearGradientBrush x:Key="KronoPrimaryFace" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#A4F0C8" Offset="0"/><GradientStop Color="#69D6A0" Offset="1"/></LinearGradientBrush>
                    <SolidColorBrush x:Key="KronoBorder" Color="#2B3B4C" />
                    <SolidColorBrush x:Key="KronoMuted" Color="#9AABBF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#293D48" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#344D59" />
                    <SolidColorBrush x:Key="KronoAccentForeground" Color="#84E6B1" />
                    <SolidColorBrush x:Key="KronoDangerForeground" Color="#FF9292" />
                    <SolidColorBrush x:Key="KronoAccentFill" Color="#84E6B1" />
                    <SolidColorBrush x:Key="KronoPrimaryBase" Color="#3B9F72" />
                    <SolidColorBrush x:Key="KronoAccentHover" Color="#A0F0C5" />
                    <SolidColorBrush x:Key="KronoAccentPressed" Color="#70D39F" />
                    <SolidColorBrush x:Key="KronoLoginBackdrop" Color="#111D20" />
                    <SolidColorBrush x:Key="KronoOutlineHover" Color="#537D70" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#84E6B1" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#70D39F" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#5CC08C" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#84E6B1" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#A0F0C5" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#70D39F" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#84E6B1" />
                </ColorPaletteResources>
                <ColorPaletteResources x:Key="Light" Accent="#278254">
                    <SolidColorBrush x:Key="KronoBackground" Color="#F2F5F7" />
                    <SolidColorBrush x:Key="KronoSidebar" Color="#E7EEF0" />
                    <SolidColorBrush x:Key="KronoContextRail" Color="#DCE7E8" />
                    <SolidColorBrush x:Key="KronoSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="KronoInputFace" Color="#F7FAF9"/>
                    <StaticResource x:Key="TabViewItemHeaderBackground" ResourceKey="KronoSidebar" />
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="KronoSurface" />
                    <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver" ResourceKey="KronoInputFace" />
                    <StaticResource x:Key="TabViewItemHeaderBackgroundPressed" ResourceKey="KronoSurface" />
                    <SolidColorBrush x:Key="KronoInputRim" Color="#CDDADC" />
                    <SolidColorBrush x:Key="KronoInputShade" Color="#DFE8E6" />
                    <SolidColorBrush x:Key="KronoDisabledFace" Color="#D2DBD8"/>
                    <SolidColorBrush x:Key="KronoDisabledBase" Color="#A8B5B2"/>
                    <SolidColorBrush x:Key="KronoDisabledInk" Color="#495451"/>
                    <LinearGradientBrush x:Key="KronoButtonFace" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#E5EDEA" Offset="1"/></LinearGradientBrush>
                    <LinearGradientBrush x:Key="KronoPrimaryFace" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#A4F0C8" Offset="0"/><GradientStop Color="#69D6A0" Offset="1"/></LinearGradientBrush>
                    <SolidColorBrush x:Key="KronoBorder" Color="#CDDADC" />
                    <SolidColorBrush x:Key="KronoMuted" Color="#536D78" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D8E9E5" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C3DDD6" />
                    <SolidColorBrush x:Key="KronoAccentForeground" Color="#17613E" />
                    <SolidColorBrush x:Key="KronoDangerForeground" Color="#A5262D" />
                    <SolidColorBrush x:Key="KronoAccentFill" Color="#84E6B1" />
                    <SolidColorBrush x:Key="KronoPrimaryBase" Color="#3B9F72" />
                    <SolidColorBrush x:Key="KronoAccentHover" Color="#A0F0C5" />
                    <SolidColorBrush x:Key="KronoAccentPressed" Color="#70D39F" />
                    <SolidColorBrush x:Key="KronoLoginBackdrop" Color="#E9F3EF" />
                    <SolidColorBrush x:Key="KronoOutlineHover" Color="#608678" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#84E6B1" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#70D39F" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#5CC08C" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#17613E" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#145437" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#236D49" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#21774F" />
                </ColorPaletteResources>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#10231F" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#10231F" />
            <FontFamily x:Key="KronoTextFont">ms-appx:///Assets/Fonts/Rubik.ttf#Rubik</FontFamily>
            <FontFamily x:Key="KronoDisplayFont">ms-appx:///Assets/Fonts/Rubik.ttf#Rubik</FontFamily>
            <FontFamily x:Key="KronoCodeFont">ms-appx:///Assets/Fonts/JetBrainsMono.ttf#JetBrains Mono</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Rubik.ttf#Rubik</FontFamily>
            <x:Double x:Key="KronoTextSize">14</x:Double>
            <x:Double x:Key="KronoCodeSize">14</x:Double>
            <x:Double x:Key="KronoControlMinHeight">40</x:Double>
            <DataTemplate x:Key="KronoTabTitle">
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
