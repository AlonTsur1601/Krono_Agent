<Page x:Class="Krono_Agent.MainPage" FontFamily="{ThemeResource KronoTextFont}" FontSize="{ThemeResource KronoTextSize}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Krono_Agent" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
<Grid Background="{ThemeResource KronoBackground}">
<NavigationView x:Name="Nav" Visibility="Collapsed" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Auto" OpenPaneLength="240" Background="{ThemeResource KronoSidebar}" SelectionChanged="Navigate">
<NavigationView.PaneHeader><StackPanel Orientation="Horizontal" Spacing="5" Margin="18,8,0,22" AutomationProperties.Name="Krono Agent"><Image Width="34" Height="34"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Krono.svg"/></Image.Source></Image><StackPanel VerticalAlignment="Center"><TextBlock Text="KRONO" FontSize="19" FontWeight="Bold" CharacterSpacing="160"/><TextBlock Text="AGENT" FontSize="9" CharacterSpacing="220" Foreground="{ThemeResource KronoMuted}"/></StackPanel></StackPanel></NavigationView.PaneHeader>
<NavigationView.MenuItems>
<NavigationViewItem Content="Chats" Icon="Message" Tag="chats" IsSelected="True"/>
<NavigationViewItem Content="Projects &amp; memory" Icon="Folder" Tag="projects"/>
<NavigationViewItem Content="Browser" Icon="World" Tag="browser"/>
<NavigationViewItem Content="Games" Icon="Play" Tag="games"/>
<NavigationViewItem Content="Terminal" Icon="Document" Tag="terminal"/>
<NavigationViewItem Content="Scheduled tasks" Icon="Clock" Tag="schedule"/>
</NavigationView.MenuItems>
<NavigationView.FooterMenuItems>
<NavigationViewItem Content="Settings" Icon="Setting" Tag="settings"/>
</NavigationView.FooterMenuItems>
<NavigationView.PaneFooter>
<StackPanel>
<Button x:Name="UpdateButton" Style="{StaticResource KronoFlatButton}" Visibility="Collapsed" Margin="4,0,4,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="40" Padding="10,6" Background="Transparent" BorderThickness="0" FontWeight="Normal" Click="UpdateAction">
<StackPanel Spacing="5">
<StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><SymbolIcon Symbol="Download" Width="20" Height="20"/><TextBlock x:Name="UpdateLabel" VerticalAlignment="Center"/></StackPanel>
<ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" AutomationProperties.Name="Update download progress"/>
</StackPanel>
</Button>
<Button x:Name="SignOutButton" Style="{StaticResource KronoFlatButton}" AutomationProperties.Name="Sign out" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="40" Margin="4,0" Padding="10,6" Background="Transparent" BorderThickness="0" FontWeight="Normal" Click="SignOut">
<StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
<PathIcon Width="20" Height="20" Data="M2,2 H10 V4 H4 V16 H10 V18 H2 Z M8,9 H15 L12,6 L13.5,4.5 L19,10 L13.5,15.5 L12,14 L15,11 H8 Z"/>
<TextBlock x:Name="SignOutLabel" Text="Sign out" VerticalAlignment="Center"/>
</StackPanel>
</Button>
</StackPanel>
</NavigationView.PaneFooter>
<Grid Padding="28,20,28,24" RowSpacing="12" Background="{ThemeResource KronoBackground}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid x:Name="WorkspacePattern" Grid.RowSpan="3" Margin="0,-20,0,0" IsHitTestVisible="False"/>
<Viewbox x:Name="HalloweenCorner" Grid.RowSpan="3" Width="184" Height="138" Margin="0,0,18,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
<Canvas Width="184" Height="138">
<Path Stroke="{ThemeResource KronoMuted}" StrokeThickness="1" Opacity=".33"
      Data="M184,0 L45,0 M184,0 L67,43 M184,0 L100,76 M184,0 L140,102 M184,0 L184,110 M157,0 Q163,8 161,9 Q170,11 168,15 Q175,15 176,19 Q180,18 184,21 M128,0 Q141,15 137,17 Q152,20 150,31 Q165,29 166,42 Q176,38 184,47 M96,0 Q111,22 110,27 Q128,30 128,51 Q151,48 155,68 Q169,64 184,75 M64,0 Q82,25 81,38 Q104,44 103,73 Q132,66 144,93 Q162,84 184,101"/>
<Path Stroke="{ThemeResource KronoMuted}" StrokeThickness="1" Opacity=".6" Data="M140,102 V116"/>
<Path Canvas.Left="125" Canvas.Top="110" Fill="{ThemeResource KronoAccentFill}" Opacity=".8"
      Data="F0 M15,6 C10,0 2,5 2,13 C2,21 8,25 15,23 C22,25 28,21 28,13 C28,5 20,0 15,6 Z M8,11 L13,13 L8,15 Z M22,11 L17,13 L22,15 Z M10,18 L13,18 L14,20 L16,18 L20,18 Q15,23 10,18 Z M14,5 Q14,1 18,0 L18,2 Q16,3 16,6 Z"/>
</Canvas>
</Viewbox>
<StackPanel Spacing="8"><InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Error"/>
<InfoBar x:Name="RunActivity" IsOpen="False" IsClosable="False" IsIconVisible="False" Background="{ThemeResource KronoSurface}" BorderBrush="{ThemeResource KronoBorder}" Closed="ActivityClosed"><InfoBar.ActionButton><Button Content="Open chat" Click="OpenActivityChat"/></InfoBar.ActionButton></InfoBar>
</StackPanel>
<InfoBar x:Name="Approval" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Warning" Title="Agent action needs approval"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Review details" Click="ReviewApproval"/><Button Content="Allow once" Click="Approve"/><Button Content="Deny" Click="Deny"/></StackPanel></InfoBar>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="SideColumn" Width="0"/></Grid.ColumnDefinitions>
<ContentControl x:Name="Body" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
<primitives:Thumb x:Name="SideGrip" Grid.Column="1" Width="8" Margin="8,0" Background="{ThemeResource KronoBorder}" Visibility="Collapsed" DragDelta="ResizeSideChat"/>
<Border x:Name="SideSurface" Grid.Column="2" Visibility="Collapsed" CornerRadius="18" BorderThickness="1" BorderBrush="{ThemeResource KronoBorder}" Background="{ThemeResource KronoSidebar}" Padding="16"><ContentControl x:Name="SideBody" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Border>
</Grid>
</Grid></NavigationView>
<ProgressRing x:Name="StartupProgress" IsActive="True" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
<ScrollViewer x:Name="SignIn" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
<Grid Background="{ThemeResource KronoLoginBackdrop}">
<Grid x:Name="LoginPattern" IsHitTestVisible="False"/>
<Border Margin="24" MaxWidth="440" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="32" CornerRadius="22" Background="{ThemeResource KronoSurface}" BorderBrush="{ThemeResource KronoBorder}" BorderThickness="1">
<Grid>
<StackPanel x:Name="LoginForm" Spacing="14">
<Image Width="72" Height="72" HorizontalAlignment="Left"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Krono.svg"/></Image.Source></Image>
<TextBlock Text="Welcome to Krono" FontFamily="{ThemeResource KronoDisplayFont}" Style="{ThemeResource TitleTextBlockStyle}"/>
<TextBlock Text="Sign in to your workspace." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<local:KronoTextBox x:Name="EmailInput" Header="Email" InputScope="EmailSmtpAddress"/>
<StackPanel Spacing="4">
<TextBlock Text="Password"/>
<Grid>
<PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Password" PasswordRevealMode="Hidden" Padding="12,8,46,8" Loaded="CenterPasswordContent"/>
<ToggleButton x:Name="PasswordVisibility" AutomationProperties.Name="Show password" ToolTipService.ToolTip="Show password" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Width="34" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Checked="PasswordVisibilityChanged" Unchecked="PasswordVisibilityChanged">
<FontIcon x:Name="PasswordEye" Glyph="&#xE890;" FontSize="16"/>
</ToggleButton>
</Grid>
</StackPanel>
<Button x:Name="LoginButton" Content="Sign in" Style="{StaticResource KronoPrimaryButton}" HorizontalAlignment="Stretch" Click="Login"/>
<Button x:Name="RegisterButton" Content="Create an account" HorizontalAlignment="Stretch" Click="Register"/>
<ProgressRing x:Name="AuthProgress" Visibility="Collapsed" IsActive="False" Width="24" Height="24"/>
<TextBlock x:Name="AuthError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
<TextBlock Text="Your sign-in is encrypted on this Windows account and remembered until you sign out." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
</StackPanel>
<StackPanel x:Name="ConfirmationForm" Visibility="Collapsed" Spacing="14">
<SymbolIcon Symbol="Mail" HorizontalAlignment="Left" Foreground="{ThemeResource KronoAccentForeground}"/>
<TextBlock Text="Check your email" FontFamily="{ThemeResource KronoDisplayFont}" Style="{ThemeResource TitleTextBlockStyle}"/>
<TextBlock x:Name="ConfirmationInstructions" TextWrapping="Wrap"/>
<TextBlock x:Name="ConfirmationAddress" TextWrapping="Wrap" FontWeight="SemiBold"/>
<TextBlock Text="Open the confirmation link, then return to Krono Agent and sign in. If you do not see the email, check your spam or junk folder." TextWrapping="Wrap" Foreground="{ThemeResource KronoMuted}"/>
<Button x:Name="BackToLoginButton" Content="Back to sign in" Style="{StaticResource KronoPrimaryButton}" HorizontalAlignment="Stretch" Click="BackToLogin"/>
<Button x:Name="ResendConfirmationButton" Content="Send a new email" HorizontalAlignment="Stretch" Click="ResendConfirmation"/>
<TextBlock x:Name="ConfirmationStatus" TextWrapping="Wrap" Foreground="{ThemeResource KronoMuted}" AutomationProperties.LiveSetting="Polite"/>
</StackPanel>
</Grid></Border></Grid></ScrollViewer>
</Grid></Page>

