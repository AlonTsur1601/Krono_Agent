<Page x:Class="Krono_Agent.MainPage" Language="en-US" FlowDirection="LeftToRight" FontFamily="{ThemeResource KronoTextFont}" FontSize="{ThemeResource KronoTextSize}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Krono_Agent" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
<Page.Resources>
    <ControlTemplate x:Key="ChatRailAction" TargetType="Button">
        <Grid Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.12"/></VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Tint.Opacity" Value=".58"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters>
                        <Setter Target="Tint.Opacity" Value=".78"/>
                        <Setter Target="Tint.Background" Value="{ThemeResource ButtonBackgroundPressed}"/>
                    </VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Face.Opacity" Value=".45"/></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Tint" CornerRadius="7" Background="{ThemeResource ButtonBackgroundPointerOver}" Opacity="0" IsHitTestVisible="False"/>
            <ContentPresenter x:Name="Face" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
        </Grid>
    </ControlTemplate>
    <Style x:Key="ChatRailIconButton" TargetType="Button" BasedOn="{StaticResource KronoButton}">
        <Setter Property="Template" Value="{StaticResource ChatRailAction}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <DataTemplate x:Key="ChatRailHeading">
        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DataTemplate>
    <DataTemplate x:Key="ChatRailDisclosure">
        <Button Template="{StaticResource ChatRailAction}" Click="ChatRailDisclosureClicked"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="34" Padding="13,0,6,0"
                AutomationProperties.Name="{Binding ActionLabel}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding Icon}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Button>
    </DataTemplate>
    <DataTemplate x:Key="ChatRailMore">
        <Button Template="{StaticResource ChatRailAction}" Click="ChatRailMoreClicked" Content="{Binding Name}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="32" Padding="16,0,0,0"
                AutomationProperties.Name="{Binding ActionLabel}"/>
    </DataTemplate>
    <DataTemplate x:Key="ChatRailConversation">
        <Grid Background="Transparent" MinHeight="34" ColumnSpacing="8" Margin="{Binding Indent}"
              PointerEntered="ChatRowPointerEntered" PointerExited="ChatRowPointerExited">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <ProgressRing Grid.Column="1" Width="13" Height="13" Foreground="{ThemeResource KronoAccentForeground}" Visibility="{Binding WorkingVisibility}" IsActive="{Binding Working}" AutomationProperties.Name="Agent working"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                <Button Style="{StaticResource ChatRailIconButton}" Width="24" Height="24" Click="ChatPinClicked"
                        Content="{Binding PinIcon}" Visibility="{Binding PinVisibility}" AutomationProperties.Name="{Binding PinLabel}"
                        ToolTipService.ToolTip="{Binding PinLabel}"/>
                <Button Style="{StaticResource ChatRailIconButton}" Width="24" Height="24" Click="ChatArchiveClicked"
                        Content="{Binding ArchiveIcon}" AutomationProperties.Name="{Binding ArchiveLabel}"
                        ToolTipService.ToolTip="{Binding ArchiveLabel}"/>
            </StackPanel>
        </Grid>
    </DataTemplate>
</Page.Resources>
<Grid Background="{ThemeResource KronoBackground}">
<NavigationView x:Name="Nav" Visibility="Collapsed" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneOpen="False" IsPaneToggleButtonVisible="False" PaneDisplayMode="LeftCompact" CompactPaneLength="48" Background="{ThemeResource KronoSidebar}" SelectionChanged="Navigate" ItemInvoked="InvokeNavigationAction">
<NavigationView.Resources>
<CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
<Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
</NavigationView.Resources>
<NavigationView.PaneHeader><StackPanel Orientation="Horizontal" Spacing="5" Margin="18,8,0,22" AutomationProperties.Name="Krono Agent"><Image Width="34" Height="34"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Krono.svg"/></Image.Source></Image><StackPanel VerticalAlignment="Center"><TextBlock Text="KRONO" FontSize="19" FontWeight="Bold" CharacterSpacing="160"/><TextBlock Text="AGENT" FontSize="9" CharacterSpacing="220" Foreground="{ThemeResource KronoMuted}"/></StackPanel></StackPanel></NavigationView.PaneHeader>
<NavigationView.MenuItems>
<NavigationViewItem Content="Chats" Tag="chats" IsSelected="True"><NavigationViewItem.Icon><PathIcon Data="F0 M5.5,2.5 H14.5 Q18,2.5 18,6 V12 Q18,15.5 14.5,15.5 H9 L4,18 V15.2 Q2,14.35 2,12 V6 Q2,2.5 5.5,2.5 Z M5.5,4 Q3.5,4 3.5,6 V12 Q3.5,13.6 5.5,14 V15.55 L8.65,14 H14.5 Q16.5,14 16.5,12 V6 Q16.5,4 14.5,4 Z M6,7 H14 V8.5 H6 Z M6,10 H11 V11.5 H6 Z"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem Content="Projects" Tag="projects" Visibility="Collapsed"/>
<NavigationViewItem x:Name="BrowserNavigation" Content="Browser" Tag="browser"/>
<NavigationViewItem Content="Games" Tag="games"><NavigationViewItem.Icon><PathIcon Data="F0 M2.5,2.5 Q2.5,1.6 3.3,2 L17.5,9.3 Q18.7,10 17.5,10.7 L3.3,18 Q2.5,18.4 2.5,17.5 Z M4,4.2 V15.8 L15.6,10 Z"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem Content="Terminal" Tag="terminal"><NavigationViewItem.Icon><PathIcon Data="M5,5.5 L6.05,6.55 L2.6,10 L6.05,13.45 L5,14.5 L0.5,10 Z M11,4 L12.4,4.5 L9,16 L7.6,15.5 Z M15,5.5 L19.5,10 L15,14.5 L13.95,13.45 L17.4,10 L13.95,6.55 Z"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem Content="Scheduled tasks" Tag="schedule"><NavigationViewItem.Icon><PathIcon Data="F0 M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 Z M10,3.5 A6.5,6.5 0 1 1 10,16.5 A6.5,6.5 0 1 1 10,3.5 Z M9.25,5.5 H10.75 V9.25 H14 V10.75 H9.25 Z"/></NavigationViewItem.Icon></NavigationViewItem>
</NavigationView.MenuItems>
<NavigationView.FooterMenuItems>
<NavigationViewItem x:Name="UpdateButton" Visibility="Collapsed" SelectsOnInvoked="False" Tag="update">
<TextBlock x:Name="UpdateLabel" Foreground="{ThemeResource KronoAccentForeground}"/>
</NavigationViewItem>
<NavigationViewItem Content="Settings" Tag="settings"><NavigationViewItem.Icon><PathIcon Data="F0 M8,1.5 H12 L12.6,4 L14,4.8 L16.45,4.05 L18.45,7.5 L16.6,9.3 V10.7 L18.45,12.5 L16.45,15.95 L14,15.2 L12.6,16 L12,18.5 H8 L7.4,16 L6,15.2 L3.55,15.95 L1.55,12.5 L3.4,10.7 V9.3 L1.55,7.5 L3.55,4.05 L6,4.8 L7.4,4 Z M9.2,3 L8.7,5 L6.2,6.45 L4.25,5.85 L3.4,7.3 L4.9,8.7 V11.3 L3.4,12.7 L4.25,14.15 L6.2,13.55 L8.7,15 L9.2,17 H10.8 L11.3,15 L13.8,13.55 L15.75,14.15 L16.6,12.7 L15.1,11.3 V8.7 L16.6,7.3 L15.75,5.85 L13.8,6.45 L11.3,5 L10.8,3 Z M10,6.75 A3.25,3.25 0 1 0 10,13.25 A3.25,3.25 0 1 0 10,6.75 Z M10,8.25 A1.75,1.75 0 1 1 10,11.75 A1.75,1.75 0 1 1 10,8.25 Z"/></NavigationViewItem.Icon></NavigationViewItem>
<NavigationViewItem x:Name="SignOutButton" Content="Sign out" SelectsOnInvoked="False" Tag="signout"><NavigationViewItem.Icon><PathIcon Data="M3.125,2 H11.125 V3.5 H3.125 V16.5 H11.125 V18 H3.125 Q1.625,18 1.625,16.5 V3.5 Q1.625,2 3.125,2 Z M8.125,9.25 H15.525 L12.725,6.45 L13.775,5.4 L18.375,10 L13.775,14.6 L12.725,13.55 L15.525,10.75 H8.125 Z"/></NavigationViewItem.Icon></NavigationViewItem>
</NavigationView.FooterMenuItems>
<Grid Background="{ThemeResource KronoSidebar}">
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="ContextRail" CornerRadius="14,0,0,0" Background="{ThemeResource KronoContextRail}" Width="0" Visibility="Collapsed">
<ScrollViewer x:Name="ContextScroll" Width="252" HorizontalAlignment="Left" Padding="16,20,16,16" VerticalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto"><ContentControl x:Name="ContextBody" Width="220" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></ScrollViewer>
</Border>
<Border x:Name="WorkspaceSurface" Grid.Column="1" CornerRadius="14,0,0,0" Background="{ThemeResource KronoBackground}">
<Grid Padding="28,12,28,12" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid x:Name="WorkspacePattern" Grid.RowSpan="3" Margin="0,-12,0,0" IsHitTestVisible="False"/>
<Viewbox x:Name="HalloweenCorner" Grid.RowSpan="3" Width="184" Height="138" Margin="0,-12,-28,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
<Canvas Width="184" Height="138">
<Path Stroke="{ThemeResource KronoMuted}" StrokeThickness="1" Opacity=".33"
      Data="M184,0 L45,0 M184,0 L67,43 M184,0 L100,76 M184,0 L140,102 M184,0 L184,110 M157,0 Q163,8 161,9 Q170,11 168,15 Q175,15 176,19 Q180,18 184,21 M128,0 Q141,15 137,17 Q152,20 150,31 Q165,29 166,42 Q176,38 184,47 M96,0 Q111,22 110,27 Q128,30 128,51 Q151,48 155,68 Q169,64 184,75 M64,0 Q82,25 81,38 Q104,44 103,73 Q132,66 144,93 Q162,84 184,101"/>
</Canvas>
</Viewbox>
<Viewbox x:Name="HalloweenPumpkin" Grid.RowSpan="3" Width="34" Height="30" Margin="0,0,-18,-8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
<Canvas Width="30" Height="26">
<Path Fill="{ThemeResource KronoAccentFill}" Opacity=".8"
      Data="F0 M15,6 C10,0 2,5 2,13 C2,21 8,25 15,23 C22,25 28,21 28,13 C28,5 20,0 15,6 Z M8,11 L13,13 L8,15 Z M22,11 L17,13 L22,15 Z M10,18 L13,18 L14,20 L16,18 L20,18 Q15,23 10,18 Z M14,5 Q14,1 18,0 L18,2 Q16,3 16,6 Z"/>
</Canvas>
</Viewbox>
<StackPanel Spacing="8">
<InfoBar x:Name="RunActivity" IsOpen="False" IsClosable="False" IsIconVisible="False" Background="{ThemeResource KronoSurface}" BorderBrush="{ThemeResource KronoBorder}" Closed="ActivityClosed"><InfoBar.ActionButton><Button Content="Open chat" Click="OpenActivityChat"/></InfoBar.ActionButton></InfoBar>
</StackPanel>
<InfoBar x:Name="Approval" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Warning" Title="Agent action needs approval"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Review details" Click="ReviewApproval"/><Button Content="Allow once" Click="Approve"/><Button Content="Deny" Click="Deny"/></StackPanel></InfoBar>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="SideColumn" Width="0"/></Grid.ColumnDefinitions>
<ContentControl x:Name="Body" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
<primitives:Thumb x:Name="SideGrip" Grid.Column="1" Width="8" Margin="8,0" Background="{ThemeResource KronoBorder}" Visibility="Collapsed" DragDelta="ResizeSideChat"/>
<Border x:Name="SideSurface" Grid.Column="2" Visibility="Collapsed" CornerRadius="18" BorderThickness="1" BorderBrush="{ThemeResource KronoBorder}" Background="{ThemeResource KronoSidebar}" Padding="16"><ContentControl x:Name="SideBody" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Border>
</Grid>
</Grid></Border></Grid></NavigationView>
<ProgressRing x:Name="StartupProgress" IsActive="True" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
<ScrollViewer x:Name="SignIn" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
<Grid Background="{ThemeResource KronoBackground}">
<Grid x:Name="LoginPattern" IsHitTestVisible="False"/>
<Border x:Name="AuthCard" Margin="24" MaxWidth="440" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="32" CornerRadius="18" Background="{ThemeResource KronoSurface}" BorderBrush="{ThemeResource KronoBorder}" BorderThickness="1,1,1,3">
<Grid>
<StackPanel x:Name="LoginForm" Spacing="14" PreviewKeyDown="SubmitPassword">
<Grid ColumnSpacing="12">
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Image Width="40" Height="40" VerticalAlignment="Center"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Krono.svg"/></Image.Source></Image>
<TextBlock Grid.Column="1" x:Name="AuthTitle" Text="Welcome to Krono" FontFamily="{ThemeResource KronoDisplayFont}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
</Grid>
<TextBlock x:Name="AuthSubtitle" Text="Sign in to your workspace." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<local:KronoTextBox x:Name="EmailInput" Header="Email" InputScope="EmailSmtpAddress" Loaded="CenterAuthInput"/>
<StackPanel Spacing="4">
<TextBlock Text="Password"/>
<Grid>
<PasswordBox x:Name="PasswordInput" AutomationProperties.Name="Password" PasswordRevealMode="Hidden" Padding="12,8,46,8" Loaded="CenterAuthInput"/>
<ToggleButton x:Name="PasswordVisibility" AutomationProperties.Name="Show password" ToolTipService.ToolTip="Show password" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Width="34" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Checked="PasswordVisibilityChanged" Unchecked="PasswordVisibilityChanged">
<FontIcon x:Name="PasswordEye" Glyph="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
</ToggleButton>
</Grid>
</StackPanel>
<Grid>
<Button x:Name="LoginButton" Content="Sign in" Style="{StaticResource KronoPrimaryButton}" HorizontalAlignment="Stretch" Click="Login"/>
<Button x:Name="CreateAccountButton" Content="Create account" Visibility="Collapsed" Style="{StaticResource KronoPrimaryButton}" HorizontalAlignment="Stretch" Click="CreateAccount"/>
</Grid>
<Button Content="Continue with Google" HorizontalAlignment="Stretch" Click="SignInWithGoogle"/>
<TextBlock Text="Your sign-in is encrypted on this Windows account and remembered until you sign out." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
<Border BorderBrush="{ThemeResource KronoBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,8,0,0">
<Grid>
<StackPanel x:Name="NewAccountPrompt" Spacing="8">
<TextBlock Text="New to Krono?" HorizontalAlignment="Center" Foreground="{ThemeResource KronoMuted}"/>
<Button x:Name="RegisterButton" Content="Create an account" HorizontalAlignment="Stretch" Click="Register"/>
</StackPanel>
<StackPanel x:Name="ExistingAccountPrompt" Visibility="Collapsed" Spacing="8">
<TextBlock Text="Already have an account?" HorizontalAlignment="Center" Foreground="{ThemeResource KronoMuted}"/>
<Button x:Name="BackToSignInButton" Content="Sign in" HorizontalAlignment="Stretch" Click="BackToLogin"/>
</StackPanel>
</Grid>
</Border>
</StackPanel>
<StackPanel x:Name="ConfirmationForm" Visibility="Collapsed" Spacing="10">
<Grid ColumnSpacing="12">
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<SymbolIcon Symbol="Mail" Width="26" Height="26" VerticalAlignment="Center" Foreground="{ThemeResource KronoAccentForeground}"/>
<TextBlock Grid.Column="1" Text="Check your email" FontFamily="{ThemeResource KronoDisplayFont}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
</Grid>
<TextBlock x:Name="ConfirmationInstructions" TextWrapping="Wrap"/>
<TextBlock x:Name="ConfirmationAddress" TextWrapping="Wrap" FontWeight="SemiBold"/>
<TextBlock x:Name="ConfirmationHelp" TextWrapping="Wrap" Foreground="{ThemeResource KronoMuted}"/>
<Grid ColumnSpacing="8" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Button x:Name="BackToLoginButton" Content="Back to sign in" Style="{StaticResource KronoPrimaryButton}" HorizontalAlignment="Stretch" Click="BackToLogin"/>
<Button Grid.Column="1" x:Name="ResendConfirmationButton" Content="Send a new email" HorizontalAlignment="Stretch" Click="ResendConfirmation"/>
</Grid>
<TextBlock x:Name="ConfirmationStatus" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource KronoMuted}" AutomationProperties.LiveSetting="Polite"/>
</StackPanel>
</Grid></Border></Grid></ScrollViewer>
</Grid></Page>

