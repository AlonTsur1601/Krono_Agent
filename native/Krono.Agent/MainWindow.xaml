<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Krono_Agent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Krono Agent">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource KronoBackground}" Language="en-US" FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar FontFamily="{ThemeResource KronoTextFont}" Background="{ThemeResource KronoSidebar}" x:Name="AppTitleBar" Height="36" MinHeight="0">
            <TitleBar.LeftHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="15,0,0,0" VerticalAlignment="Center">
                    <Image Width="14" Height="14" VerticalAlignment="Center"><Image.Source><SvgImageSource UriSource="ms-appx:///Assets/Krono.svg"/></Image.Source></Image>
                    <TextBlock Text="Krono Agent" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="4,0,0,0" TitleBar.IsDragRegion="False">
                        <Button x:Name="AppBack" Width="28" Height="28" IsEnabled="False" AutomationProperties.AutomationId="AppBack" AutomationProperties.Name="Go back" ToolTipService.ToolTip="Go back (Alt+Left)"><FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE72B;"/></Button>
                        <Button x:Name="AppForward" Width="28" Height="28" IsEnabled="False" AutomationProperties.AutomationId="AppForward" AutomationProperties.Name="Go forward" ToolTipService.ToolTip="Go forward (Alt+Right)"><FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE72A;"/></Button>
                    </StackPanel>
                </StackPanel>
            </TitleBar.LeftHeader>
        </TitleBar>
        <StackPanel x:Name="HalloweenTrim" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
            <Path Width="26" Height="14" Stretch="Uniform" Fill="{ThemeResource KronoAccentFill}" Data="M0,1 L6,4 L9,3 L11,6 L13,2 L15,6 L17,3 L20,4 L26,1 L23,8 L19,7 L17,11 L15,9 L13,14 L11,9 L9,11 L7,7 L3,8 Z"/>
            <Path Width="15" Height="15" Stretch="Uniform" Fill="{ThemeResource KronoMuted}" Data="M11,0 C0,1 0,15 11,15 C16,15 18,12 19,10 C10,14 5,6 11,0 Z"/>
            <Path Width="26" Height="14" Stretch="Uniform" Fill="{ThemeResource KronoAccentFill}" Data="M0,1 L6,4 L9,3 L11,6 L13,2 L15,6 L17,3 L20,4 L26,1 L23,8 L19,7 L17,11 L15,9 L13,14 L11,9 L9,11 L7,7 L3,8 Z"/>
        </StackPanel>

        <Frame x:Name="RootFrame" Grid.Row="1" Margin="0,-2,0,0" />
    </Grid>
</Window>
