<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Krono_Agent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Krono Agent">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar FontFamily="{ThemeResource KronoTextFont}" Background="{ThemeResource KronoSidebar}" x:Name="AppTitleBar" Title="Krono Agent">
            <TitleBar.Content>
                <StackPanel x:Name="HalloweenTrim" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                    <Path Width="26" Height="14" Stretch="Uniform" Fill="{ThemeResource KronoAccentFill}" Data="M0,1 L6,4 L9,3 L11,6 L13,2 L15,6 L17,3 L20,4 L26,1 L23,8 L19,7 L17,11 L15,9 L13,14 L11,9 L9,11 L7,7 L3,8 Z"/>
                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{ThemeResource KronoMuted}" Data="M11,0 C0,1 0,15 11,15 C16,15 18,12 19,10 C10,14 5,6 11,0 Z"/>
                    <Path Width="26" Height="14" Stretch="Uniform" Fill="{ThemeResource KronoAccentFill}" Data="M0,1 L6,4 L9,3 L11,6 L13,2 L15,6 L17,3 L20,4 L26,1 L23,8 L19,7 L17,11 L15,9 L13,14 L11,9 L9,11 L7,7 L3,8 Z"/>
                </StackPanel>
            </TitleBar.Content>
            <TitleBar.IconSource>
                <ImageIconSource><ImageIconSource.ImageSource><SvgImageSource UriSource="ms-appx:///Assets/Krono.svg" /></ImageIconSource.ImageSource></ImageIconSource>
            </TitleBar.IconSource>
        </TitleBar>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
