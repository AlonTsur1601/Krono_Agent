<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Krono_Agent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Krono Agent">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar FontFamily="{ThemeResource KronoTextFont}" Background="{ThemeResource KronoSidebar}" x:Name="AppTitleBar" Title="Krono Agent">
            <TitleBar.IconSource>
                <ImageIconSource><ImageIconSource.ImageSource><SvgImageSource UriSource="ms-appx:///Assets/Krono.svg" /></ImageIconSource.ImageSource></ImageIconSource>
            </TitleBar.IconSource>
        </TitleBar>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
