<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Krono_Agent">
    <Style TargetType="local:KronoCheckBox">
        <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
        <Setter Property="FontSize" Value="{ThemeResource KronoTextSize}" />
        <Setter Property="Padding" Value="10,8,0,8" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
</ResourceDictionary>
