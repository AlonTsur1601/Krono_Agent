<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="KronoMenuPresenter" TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource KronoSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource KronoBorder}" />
        <Setter Property="BorderThickness" Value="1,1,1,3" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
        <Setter Property="FontSize" Value="{ThemeResource KronoTextSize}" />
    </Style>
    <Style x:Key="KronoPopoverPresenter" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource KronoSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource KronoBorder}" />
        <Setter Property="BorderThickness" Value="1,1,1,3" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
        <Setter Property="FontSize" Value="{ThemeResource KronoTextSize}" />
    </Style>
</ResourceDictionary>
