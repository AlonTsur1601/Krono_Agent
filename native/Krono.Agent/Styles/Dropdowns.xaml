<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Krono_Agent">
    <Style TargetType="ComboBox">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{ThemeResource KronoControlMinHeight}" />
        <Setter Property="FontFamily" Value="{ThemeResource KronoTextFont}" />
        <Setter Property="FontSize" Value="{ThemeResource KronoTextSize}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{ThemeResource KronoInputFace}" />
        <Setter Property="BorderBrush" Value="{ThemeResource KronoInputRim}" />
    </Style>
    <Style x:Key="KronoDropdownSurface" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="BorderThickness" Value="1,1,1,3" />
        <Setter Property="Background" Value="{ThemeResource KronoSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource KronoBorder}" />
    </Style>
    <Style x:Key="KronoEmptyDropdownPresenter" TargetType="FlyoutPresenter">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MaxWidth" Value="Infinity" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="FlyoutPresenter">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
